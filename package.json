{
  "name": "awwwards-mcp",
  "version": "1.16.0",
  "description": "Free MCP server giving AI agents design inspiration from Awwwards: search award-winning sites with inline screenshots and extract design DNA.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "awwwards-mcp": "dist/cli.js",
    "awwwards-index": "dist/index-cli.js",
    "awwwards-verify": "dist/verify-cli.js",
    "awwwards-build-project": "dist/build-project-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "skills"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "awwwards",
    "design",
    "inspiration",
    "web-design",
    "screenshots",
    "agent-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INSANE0777/Awwwards-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/INSANE0777/Awwwards-mcp/issues"
  },
  "homepage": "https://github.com/INSANE0777/Awwwards-mcp#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "index": "node dist/index-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx test/live-smoke.ts",
    "drift": "node scripts/parser-drift-probe.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/mocker": "^4.1.12",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
